# NOKI SERVICE public website — environment variables (Phase 1 foundation)
#
# No secret value belongs in this file, nor in any NEXT_PUBLIC_* variable:
# anything prefixed NEXT_PUBLIC_ is shipped to the browser as plain text.
# This Phase 1 foundation makes no API calls and stores no personal data,
# so no backend credential is required at all.

# Base public URL of this site, used for canonical/OG/hreflang metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When "true", non-production deployments are marked noindex,nofollow via
# robots metadata (see src/app/[locale]/layout.tsx). Must be "false" only
# on the final, human-approved production deployment.
NEXT_PUBLIC_NOINDEX=true
